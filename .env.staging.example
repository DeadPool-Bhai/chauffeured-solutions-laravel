# Copy to .env on the Hostinger staging site, then run: php artisan key:generate
APP_NAME="Chauffeured Solutions"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://staging.chauffeuredsolutions.com.au
APP_STAGING=true
STAGING_AUTH=qa:CHANGE-ME

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Hostinger mailbox. Use a real mailbox on the domain so mail passes SPF/DKIM.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Chauffeured Solutions"

# Staging: your address only. At cutover: paul@csonline.com.au,booking@csonline.com.au
LEAD_NOTIFY_TO=asker.asraf@stechs.com.au
ADMIN_PATH=admin

# reCAPTCHA v3. The key must list the staging domain. Leave blank to skip the check.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
